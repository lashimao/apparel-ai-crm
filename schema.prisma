// Prisma Schema for 外贸 AI CRM
// 基于 PostgreSQL 16 + pgvector 扩展

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector(map: "vector")]
}

// ========== 认证模块 ==========
model User {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @default(1) @map("tenant_id")
  email     String   @unique
  password  String
  name      String
  role      String   @default("sales") // admin / manager / sales / finance
  avatar    String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inquiries Inquiry[]
  quotations Quotation[]
  orders     Order[]
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequester")
  approvedRequests   ApprovalRequest[] @relation("ApprovalApprover")
  uploadedAttachments Attachment[]
  createdDocumentTemplates DocumentTemplate[]

  @@map("users")
}

// ========== 客户模块 ==========
model Customer {
  id            BigInt   @id @default(autoincrement())
  tenantId      BigInt   @default(1) @map("tenant_id")
  companyName   String   @map("company_name")
  country       String?
  website       String?
  industry      String?
  customerLevel String?  @map("customer_level") // A/B/C/D
  source        String?  // exhibition / b2b / customs / social / referral
  status        String   @default("active") // active / inactive / lost
  tags          String[]
  aiScore       Float?   @default(0) @map("ai_score")
  aiProfile     Json?    @map("ai_profile")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lastContactAt DateTime? @map("last_contact_at")

  contacts       Contact[]
  inquiries      Inquiry[]
  quotations     Quotation[]
  orders         Order[]
  communications Communication[]
  attachments     Attachment[]

  @@index([tenantId])
  @@index([country])
  @@index([customerLevel])
  @@map("customers")
}

model Contact {
  id               BigInt   @id @default(autoincrement())
  tenantId         BigInt   @default(1) @map("tenant_id")
  customerId       BigInt   @map("customer_id")
  name             String
  email            String?
  phone            String?
  whatsapp         String?
  position         String?
  isDecisionMaker  Boolean  @default(false) @map("is_decision_maker")
  createdAt        DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("contacts")
}

// ========== 询盘模块 ==========
model Inquiry {
  id               BigInt   @id @default(autoincrement())
  tenantId         BigInt   @default(1) @map("tenant_id")
  customerId       BigInt   @map("customer_id")
  inquiryNo        String   @unique @map("inquiry_no")
  source           String?  // email / website / whatsapp / exhibition
  subject          String?
  content          String   @db.Text
  contentTranslated String? @map("content_translated") @db.Text
  language         String?
  status           String   @default("new") // new / assigned / quoted / won / lost
  assignedTo       BigInt?  @map("assigned_to")
  priority         String   @default("normal") // low / normal / high / urgent
  aiAnalysis       Json?    @map("ai_analysis")
  aiReplyDraft     String?  @map("ai_reply_draft") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  customer   Customer @relation(fields: [customerId], references: [id])
  assignee   User?    @relation(fields: [assignedTo], references: [id])
  quotations Quotation[]

  @@index([customerId])
  @@index([status])
  @@index([assignedTo])
  @@map("inquiries")
}

// ========== 报价模块 ==========
model Quotation {
  id           BigInt   @id @default(autoincrement())
  tenantId     BigInt   @default(1) @map("tenant_id")
  inquiryId    BigInt?  @map("inquiry_id")
  customerId   BigInt   @map("customer_id")
  quoteNo      String   @unique @map("quote_no")
  version      Int      @default(1)
  tradeTerm    String?  @map("trade_term") // FOB / CIF / EXW / DDP
  currency     String   @default("USD")
  exchangeRate Decimal? @map("exchange_rate") @db.Decimal(10, 4)
  totalAmount  Decimal? @map("total_amount") @db.Decimal(15, 2)
  totalCost    Decimal? @map("total_cost") @db.Decimal(15, 2)
  profitRate   Decimal? @map("profit_rate") @db.Decimal(5, 2)
  minProfitRate Decimal? @map("min_profit_rate") @db.Decimal(5, 2)
  status       String   @default("draft") // draft / cost_check / calculated / approval / sent / customer_confirmed / expired / converted / rejected
  approvalStatus String @default("not_required") @map("approval_status") // not_required / pending / approved / rejected
  lowMarginReason String? @map("low_margin_reason") @db.Text
  validUntil   DateTime? @map("valid_until")
  sentAt       DateTime? @map("sent_at")
  confirmedAt DateTime? @map("confirmed_at")
  aiSuggestion Json?    @map("ai_suggestion")
  createdBy    BigInt   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer  Customer       @relation(fields: [customerId], references: [id])
  inquiry   Inquiry?       @relation(fields: [inquiryId], references: [id])
  creator   User           @relation(fields: [createdBy], references: [id])
  items     QuotationItem[]
  orders    Order[]
  approvals ApprovalRequest[]
  attachments Attachment[]

  @@index([customerId])
  @@index([inquiryId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id           BigInt   @id @default(autoincrement())
  quotationId  BigInt   @map("quotation_id")
  productId    BigInt?  @map("product_id")
  productName  String   @map("product_name")
  quantity     Int
  unit         String   @default("PCS")
  unitPrice    Decimal  @map("unit_price") @db.Decimal(15, 4)
  cost         Decimal? @db.Decimal(15, 4)
  targetProfitRate Decimal? @map("target_profit_rate") @db.Decimal(5, 2)
  lineAmount   Decimal? @map("line_amount") @db.Decimal(15, 2)
  lineCost     Decimal? @map("line_cost") @db.Decimal(15, 2)
  aiPriceRef   Json?    @map("ai_price_ref")
  priceLocked  Boolean  @default(false) @map("price_locked") // AI 只能建议，人工锁价后才可发送

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@map("quotation_items")
}

// ========== 订单模块 ==========
model Order {
  id           BigInt   @id @default(autoincrement())
  tenantId     BigInt   @default(1) @map("tenant_id")
  quotationId  BigInt?  @map("quotation_id")
  customerId   BigInt   @map("customer_id")
  orderNo      String   @unique @map("order_no")
  piNo         String?  @map("pi_no")
  status       String   @default("pending") // pending / confirmed / deposit_paid / in_production / ready_to_ship / shipped / completed / cancelled
  totalAmount  Decimal  @map("total_amount") @db.Decimal(15, 2)
  currency     String   @default("USD")
  paymentTerm  String?  @map("payment_term")
  incoterm      String?  // FOB / CIF / DDP / EXW
  depositRate   Decimal? @map("deposit_rate") @db.Decimal(5, 2)
  deliveryDate DateTime? @map("delivery_date")
  shipDate      DateTime? @map("ship_date")
  aiRiskScore Float?   @default(0) @map("ai_risk_score")
  createdBy    BigInt   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer   Customer     @relation(fields: [customerId], references: [id])
  quotation  Quotation?   @relation(fields: [quotationId], references: [id])
  creator    User         @relation(fields: [createdBy], references: [id])
  documents  Document[]
  payments   Payment[]
  productions Production[]
  items      OrderItem[]
  attachments Attachment[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

// ========== 产品模块 ==========
model OrderItem {
  id          BigInt   @id @default(autoincrement())
  orderId     BigInt   @map("order_id")
  productId   BigInt?  @map("product_id")
  productName String   @map("product_name")
  quantity    Int
  unit        String   @default("PCS")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(15, 4)
  lineAmount  Decimal  @map("line_amount") @db.Decimal(15, 2)
  specification String? @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Product {
  id            BigInt   @id @default(autoincrement())
  tenantId      BigInt   @default(1) @map("tenant_id")
  productCode   String   @unique @map("product_code")
  name          String
  nameEn        String?  @map("name_en")
  category      String?
  specification String?  @db.Text
  unit          String   @default("PCS")
  costPrice     Decimal  @map("cost_price") @db.Decimal(15, 4)
  minPrice      Decimal? @map("min_price") @db.Decimal(15, 4)
  standardPrice Decimal? @map("standard_price") @db.Decimal(15, 4)
  keywords      String[]
  imageUrl      String?  @map("image_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  quotationItems QuotationItem[]
  orderItems     OrderItem[]

  @@index([tenantId])
  @@index([category])
  @@map("products")
}

// ========== 生产跟踪模块 ==========
model Production {
  id          BigInt   @id @default(autoincrement())
  orderId     BigInt   @map("order_id")
  stage       String   // planned / in_progress / quality_check / completed
  progress    Int      @default(0) // 0-100
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("productions")
}

// ========== 单证模块 ==========
model Document {
  id           BigInt   @id @default(autoincrement())
  tenantId     BigInt   @default(1) @map("tenant_id")
  orderId      BigInt   @map("order_id")
  docType      String   @map("doc_type") // CI / PL / BL / CO / Insurance
  docNo        String?  @map("doc_no")
  fileUrl      String?  @map("file_url")
  status       String   @default("draft") // draft / generated / verified / sent
  aiGenerated  Boolean  @default(false) @map("ai_generated")
  aiVerified   Boolean  @default(false) @map("ai_verified")
  humanVerifiedBy BigInt? @map("human_verified_by")
  templateId    BigInt? @map("template_id")
  data         Json?
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template DocumentTemplate? @relation(fields: [templateId], references: [id])

  @@index([orderId])
  @@index([docType, status])
  @@map("documents")
}

// ========== 财务模块 ==========
model Payment {
  id            BigInt    @id @default(autoincrement())
  tenantId      BigInt    @default(1) @map("tenant_id")
  orderId       BigInt    @map("order_id")
  paymentType   String    @map("payment_type") // deposit / balance / freight
  plannedAmount Decimal   @map("planned_amount") @db.Decimal(15, 2)
  actualAmount  Decimal?  @map("actual_amount") @db.Decimal(15, 2)
  currency      String    @default("USD")
  exchangeRate  Decimal?  @map("exchange_rate") @db.Decimal(10, 4)
  plannedDate   DateTime? @map("planned_date")
  actualDate    DateTime? @map("actual_date")
  status        String    @default("pending") // pending / partial / paid / overdue / verified
  bankSlipUrl   String?   @map("bank_slip_url")
  verifiedBy    BigInt?   @map("verified_by")
  verifiedAt    DateTime? @map("verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// ========== 沟通记录 ==========
model Communication {
  id           BigInt   @id @default(autoincrement())
  tenantId     BigInt   @default(1) @map("tenant_id")
  customerId   BigInt   @map("customer_id")
  channel      String   // email / whatsapp / wechat / phone
  direction    String   // inbound / outbound
  subject      String?
  content      String   @db.Text
  aiSummary    String?  @map("ai_summary") @db.Text
  aiSentiment  String?  @map("ai_sentiment")
  createdAt    DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([channel])
  @@map("communications")
}

// ========== 模板、附件、审批与审计 ==========
model DocumentTemplate {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt   @default(1) @map("tenant_id")
  docType     String   @map("doc_type") // PI / SC / CI / PL / CO
  name        String
  version     Int      @default(1)
  content     Json
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   BigInt?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator   User?      @relation(fields: [createdBy], references: [id])
  documents Document[]

  @@index([tenantId, docType, isActive])
  @@map("document_templates")
}

model Attachment {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt   @default(1) @map("tenant_id")
  module      String   // customer / quotation / order / payment / document
  refId       BigInt   @map("ref_id")
  customerId  BigInt?  @map("customer_id")
  quotationId BigInt?  @map("quotation_id")
  orderId     BigInt?  @map("order_id")
  fileName    String   @map("file_name")
  fileUrl     String   @map("file_url")
  mimeType    String?  @map("mime_type")
  sha256      String?
  uploadedBy  BigInt?  @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  customer  Customer?  @relation(fields: [customerId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])
  order     Order?     @relation(fields: [orderId], references: [id])
  uploader  User?      @relation(fields: [uploadedBy], references: [id])

  @@index([module, refId])
  @@index([customerId])
  @@index([quotationId])
  @@index([orderId])
  @@map("attachments")
}

model ApprovalRequest {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt   @default(1) @map("tenant_id")
  module      String   // quotation / order / payment
  refId       BigInt   @map("ref_id")
  quotationId BigInt?  @map("quotation_id")
  reason      String   @db.Text
  status      String   @default("pending") // pending / approved / rejected / cancelled
  requestedBy BigInt   @map("requested_by")
  approverId  BigInt?  @map("approver_id")
  decidedAt   DateTime? @map("decided_at")
  decisionNote String? @map("decision_note") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quotation Quotation? @relation(fields: [quotationId], references: [id])
  requester User @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  approver  User? @relation("ApprovalApprover", fields: [approverId], references: [id])

  @@index([module, refId])
  @@index([status])
  @@map("approval_requests")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @default(1) @map("tenant_id")
  actorId   BigInt?  @map("actor_id")
  action    String
  module    String
  refId     BigInt?  @map("ref_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([module, refId])
  @@index([actorId])
  @@map("audit_logs")
}

// ========== AI 任务队列 ==========
model AiTask {
  id           BigInt    @id @default(autoincrement())
  tenantId     BigInt    @default(1) @map("tenant_id")
  taskType     String    @map("task_type") // inquiry_reply / quotation_suggest / doc_ocr / ...
  module       String    // inquiry / quotation / document / ...
  refId        BigInt?   @map("ref_id")
  status       String    @default("pending") // pending / processing / completed / failed
  input        Json?
  output       Json?
  modelUsed    String?   @map("model_used")
  tokensUsed   Int?      @default(0) @map("tokens_used")
  cost         Decimal?  @db.Decimal(10, 4)
  error        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  @@index([status])
  @@index([module, refId])
  @@map("ai_tasks")
}
